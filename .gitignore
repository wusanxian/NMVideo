# 虚拟环境与依赖
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# 数据库与产物
backend/aivideo.db
backend/outputs/
backend/models/

# 前端
frontend/node_modules/
frontend/dist/

# 打包产物与运行时（注意：desktop/build/icon.png 是源资源，需入库）
packaging/dist/
packaging/build/
packaging/.build-dist/
packaging/.build-work/
packaging/payload/
# PyInstaller spec 由 packaging/build.py 每次重新生成，内容是构建机的绝对路径
# （D:\work\NMVideo\...），入库只会在别人克隆后指向不存在的目录
packaging/*.spec
frontend/dist/
desktop/dist/
release/
desktop/node_modules/
desktop/electron-dist/
runtime/

# 系统
.DS_Store
Thumbs.db
*.log

# 本地 agent 工作数据（含记忆，勿入库）
# 例外：项目级 Agent Skills 属团队资产，随仓库分发（见 .workbuddy/skills/screenwriting-SOURCE.md）
.workbuddy/*
!.workbuddy/skills/
.phase1/

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Python 缓存与构建残留
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
.cache/
pip-log.txt

# 环境变量 / 密钥（切勿入库）
.env
.env.*
*.local
backend/settings.json

# 前端缓存与日志
.vite/
frontend/.shots/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 操作系统垃圾文件
desktop.ini
ehthumbs.db
~$*

# 工具/IDE 分析产物
.brooks-lint-history.json

# 测试文件
# backend/tests 入库：白模/资产版本这类「契约用例」是跨批次的安全网，
# 不入库等于每批都在裸奔（改了 ComfyUI 节点契约没人拦）。
# desktop/tests 仍是本地脚本，继续忽略。
desktop/tests/
test_*.py
*_test.py
backend/tests/__pycache__/
# 上面的 test_*.py 会把目录里的用例也一起忽略，这里显式放行
!backend/tests/*.py

# 本地参考素材（toonflow 等工作流示例，仅本地保留，不入库）
reference/
