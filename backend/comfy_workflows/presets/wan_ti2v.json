{
  "_comment": "Wan2.2-TI2V-5B 本地工作流（原生 ComfyUI 视频节点 + VHS_VideoCombine 直出 MP4）。",
  "_meta": {
    "name": "Wan 2.2 TI2V-5B · 文生视频",
    "description": "本地 Wan2.2-TI2V-5B：UNETLoader + 标准视频链路，VHS_VideoCombine 直出 MP4。需 ComfyUI-VideoHelperSuite。",
    "requires": "ComfyUI-VideoHelperSuite",
    "mode": "t2v",
    "execution_kind": "local",
    "model_id": "wan2.2-ti2v-5b",
    "required_nodes": ["UNETLoader", "CLIPLoader", "VAELoader", "EmptyHunyuanLatentVideo", "VHS_VideoCombine"],
    "supports": ["t2v"],
    "min_vram_gb": 8,
    "vram_hint": "RTX 4060 8GB 可跑 480p 短片段；显存不足会走 offload，速度显著下降"
  },
  "prompt": {
    "1": {"class_type": "UNETLoader",
          "inputs": {"unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "default"}},
    "2": {"class_type": "CLIPLoader",
          "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan"}},
    "3": {"class_type": "VAELoader",
          "inputs": {"vae_name": "wan2.2_vae.safetensors"}},
    "4": {"class_type": "CLIPTextEncode",
          "inputs": {"text": " cinematic shot, anime style", "clip": ["2", 0]}},
    "5": {"class_type": "CLIPTextEncode",
          "inputs": {"text": "worst quality, blurry", "clip": ["2", 0]}},
    "6": {"class_type": "EmptyHunyuanLatentVideo",
          "inputs": {"width": 512, "height": 512, "length": 49, "batch_size": 1}},
    "7": {"class_type": "KSampler",
          "inputs": {"seed": 0, "steps": 30, "cfg": 5.0,
                     "sampler_name": "uni_pc", "scheduler": "simple",
                     "denoise": 1.0, "model": ["1", 0],
                     "positive": ["4", 0], "negative": ["5", 0],
                     "latent_image": ["6", 0]}},
    "8": {"class_type": "VAEDecode",
          "inputs": {"samples": ["7", 0], "vae": ["3", 0]}},
    "9": {"class_type": "VHS_VideoCombine",
          "inputs": {"images": ["8", 0], "frame_rate": 16,
                     "loop_count": 0, "filename_prefix": "aivideo_wan",
                     "format": "video/h264-mp4", "save_output": true}}
  },
  "_aivideo_map": {
    "prompt": {"node": "4", "input": "text"},
    "negative_prompt": {"node": "5", "input": "text"},
    "width": {"node": "6", "input": "width"},
    "height": {"node": "6", "input": "height"},
    "num_frames": {"node": "6", "input": "length"},
    "fps": {"node": "9", "input": "frame_rate"},
    "seed": {"node": "7", "input": "seed"},
    "steps": {"node": "7", "input": "steps"},
    "guidance": {"node": "7", "input": "cfg"}
  }
}
